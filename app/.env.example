# ==============================================================================
# Roja Opticals - Frontend Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ── Backend API URL ───────────────────────────────────────────────────────────
# In production single-laptop mode, leave empty or set to /api for relative calls.
# During independent Vite development, set to http://127.0.0.1:5000/api.
VITE_API_URL=/api

# ── Cloud Supabase (Optional — Public anon keys only) ─────────────────────────
# Leave empty for 100% offline laptop-local mode.
# If connecting directly to Supabase cloud:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
