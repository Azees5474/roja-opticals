# ==============================================================================
# Roja Opticals - Server Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# NEVER commit or share your .env file containing live credentials.
# ==============================================================================

# ── Application Environment & Binding ─────────────────────────────────────────
NODE_ENV=production
# Bind host: 127.0.0.1 binds exclusively to local laptop (recommended).
# Set to 0.0.0.0 only if intentional local network sharing is required.
HOST=127.0.0.1
PORT=5000

# ── Standalone Laptop-Local Mode (Default for single-laptop use) ───────────────
# Set LOCAL_MODE=true to run completely offline with local JSON database.
# When true, no Supabase, Google Sheets, or Twilio cloud accounts are required.
LOCAL_MODE=true

# ── Allowed CORS Origins ──────────────────────────────────────────────────────
# Comma-separated list of additional allowed browser origins.
# (127.0.0.1:5000, localhost:5000, and standard Vite ports are permitted by default)
CLIENT_URL=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5173,http://localhost:5173

# ── Local Authentication Secret (Optional) ────────────────────────────────────
# Persistent random secret for signing local session tokens.
# If left blank, a secure 256-bit random secret is generated on first startup.
LOCAL_AUTH_SECRET=

# ── Initial Master Account Provisioning ───────────────────────────────────────
# NO DEFAULT CREDENTIALS OR FIXED PASSWORDS ARE SHIPPED WITH THIS APPLICATION.
# On first launch, the Master Owner account is created via the First-Run Shop Setup
# wizard. Subsequent attempts are permanently locked. Staff accounts are created
# by the logged-in owner in Settings.

# ── Cloud Supabase (Optional — Only needed if cloud synchronization is desired)
SUPABASE_URL=https://your-project-id.supabase.co
# SERVER ONLY: Service role key must NEVER be shared with frontend clients
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Twilio WhatsApp (Optional — Only needed for automated SMS/WhatsApp gateway)
USE_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Google Sheets Sync (Optional — Only needed for Google Sheets export) ──────
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# ── Background Scheduler ──────────────────────────────────────────────────────
# Set DISABLE_SCHEDULER=true to disable automated cron background jobs.
DISABLE_SCHEDULER=true
