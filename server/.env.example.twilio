# ── Twilio WhatsApp Configuration ────────────────────────
# Copy these lines to your .env file and fill in your values

# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio Sandbox Number (for testing)
# Production: Change to your approved WhatsApp Business number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Enable Twilio automatic sending
# Set to 'true' to send via Twilio, 'false' to use free wa.me method
USE_TWILIO=true

# ── How to Get Your Credentials ──────────────────────────
# 1. Sign up at https://www.twilio.com/try-twilio
# 2. Go to Console: https://console.twilio.com/
# 3. Copy your Account SID and Auth Token
# 4. Enable WhatsApp Sandbox:
#    - Go to Messaging → Try it Out → WhatsApp
#    - Send 'join <code>' to +1 415 523 8886 from your phone
# 5. Paste credentials above
# 6. Restart your server

# ── Cost ──────────────────────────────────────────────────
# Trial: $15.50 free credit (~3,600 messages)
# India: ~$0.0042 per message (~₹0.35)
# Monthly (100 messages/day): ~₹1,050

# ── Full Guide ────────────────────────────────────────────
# See: TWILIO_SETUP_GUIDE.md for complete instructions
